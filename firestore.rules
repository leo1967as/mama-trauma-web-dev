rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && request.auth.token.email in [
          'narawhich2547@gmail.com',
          'kornkanda2547@gmail.com',
          'kornkanda.p@kkumail.com'
        ];
    }

    match /mothers/{motherId} {
      allow read: if (signedIn() && request.auth.uid == motherId) || isStaff();
      allow create, update: if signedIn() && request.auth.uid == motherId && !isStaff();
      allow delete: if false;

      match /{document=**} {
        allow read: if (signedIn() && request.auth.uid == motherId) || isStaff();
        allow write: if signedIn() && request.auth.uid == motherId && !isStaff();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
